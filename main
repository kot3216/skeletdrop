<div style="text-align:center;margin:5px 0"><img src="${g.image}" ${fallFor(g.id)} style="height:58px;object-fit:contain;opacity:.9"><div class="muted" style="margin-top:3px">${g.name} останется в коллекции</div></div>
<button class="btn" style="width:100%" onclick="closeModal()">Понятно</button>`);}

/* рендер */
function fmtRemain(ms){const h=Math.floor(ms/3600000),m=Math.floor(ms%3600000/60000),s=Math.floor(ms%60000/1000);return`${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;}
function freeRemain(){return Math.max(0,state.lastFree+DAY-Date.now());}
function renderCases(){document.getElementById("casecount").textContent=cases.length+" наборов";
