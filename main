 if(Math.random()<0.5){const g=gifts[Math.floor(Math.random()*gifts.length)];return `<div class="liveitem"><img src="${g.image}" ${fallFor(g.id)}><div><small>${n} · ${g.name}</small><b class="giftprice">${money(g.price)}</b></div></div>`;}
 const s=LIVE_STARS[Math.floor(Math.random()*LIVE_STARS.length)];return `<div class="liveitem"><img src="${starLive}"><div><small>${n} · +${s} ⭐</small><b>${money(s*STAR_RATE)}</b></div></div>`;}
function renderLive(){const b=document.getElementById("liveitems");b.insertAdjacentHTML("afterbegin",liveItemHTML());while(b.children.length>10)b.lastElementChild.remove();}
const heroSlides=[
