 document.querySelectorAll("#heroDots i").forEach((d,i)=>d.classList.toggle("on",i===heroIndex));}
function scrollToId(id){document.getElementById(id)?.scrollIntoView({behavior:"smooth"});}
document.querySelectorAll("#bottomnav button").forEach(btn=>{btn.addEventListener("click",()=>{document.querySelectorAll("#bottomnav button").forEach(b=>b.classList.remove("active"));btn.classList.add("active");btn.dataset.target==="top"?window.scrollTo({top:0,behavior:"smooth"}):scrollToId(btn.dataset.target);});});
window.addEventListener("scroll",()=>{const y=window.scrollY+window.innerHeight*.4;let a="top";["casesTitle","gamesTitle","collection"].forEach(id=>{const el=document.getElementById(id);if(el&&el.offsetTop<=y)a=id;});document.querySelectorAll("#bottomnav button").forEach(b=>b.classList.toggle("active",b.dataset.target===a));},{passive:true});
setInterval(()=>{const b=document.getElementById("casebtn0");if(!b)return;const r=freeRemain();if(r>0){b.disabled=true;b.textContent="⏳ "+fmtRemain(r);}else{b.disabled=false;b.textContent="Открыть бесплатно";}},1000);
(function(){const b=document.getElementById("bgfx");for(let i=0;i<12;i++){const d=document.createElement("i");const s=2+Math.random()*5;d.style.width=d.style.height=s+"px";d.style.left=Math.random()*100+"%";d.style.animationDuration=(10+Math.random()*14)+"s";d.style.animationDelay=(-Math.random()*20)+"s";d.style.opacity=(.08+Math.random()*.2);b.appendChild(d);}})();

document.getElementById("heroart").style.backgroundImage=`url("${gifts[4].image}")`;
