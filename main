async function payStars(code){
 const pkg=PAY_PKGS.find(p=>p.code===code);if(!pkg)return;
 if(!TG_INIT){toast("Открой игру через бота 🤖");return;}
 if(!TGW.openInvoice){toast("Обнови Telegram до последней версии");return;}
 toast("Создаю счёт…");
 let j;try{j=await api("/api/invoice",{pkg:code});}catch(e){toast("Сервер недоступен, попробуй позже");return;}
 if(!j.ok||!j.link){toast("Не удалось создать счёт");return;}
 TGW.openInvoice(j.link,async st=>{
  if(st==="paid"){await tgLoad();closeModal();confetti(60);SFX.win();toast("Оплата прошла! +"+money(pkg.rub)+" ✅");}
  else if(st==="cancelled")toast("Оплата отменена");
  else if(st==="failed")toast("Оплата не прошла");
  else toast("Статус: "+st);
 });
}
async function activateCode(){
 const c=document.getElementById("promoInput").value.trim().toUpperCase();
 if(c.length<4)return toast("Введи промокод");
 if(c===TEST_PROMO){
  if(state.usedTest)return toast("Этот код уже использован");
  state.usedTest=true;addMoney(TEST_PROMO_VALUE);closeModal();confetti(90);SFX.win();toast("+"+money(TEST_PROMO_VALUE)+" зачислено ✅");return;
 }
 try{const j=await api("/api/check",{code:c});if(j.ok){addMoney(j.rub);closeModal();confetti(24);SFX.coin();toast("+"+money(j.rub)+" ✅");}else toast("Код не найден или использован");}catch(e){toast("Сервер недоступен");}
}

