 return `<div class="casecard glass reveal ${c.rc}"><div class="caseimg"><div class="aura"></div><span class="xbadge">макс ${money(caseMax(c))}</span><img src="${g.image}" ${fallFor(g.id)}></div>
 <div class="casefoot"><div><h3>${c.name}</h3><div class="muted">${g.name} + ⭐</div></div><div class="price ${c.free?"free":""}">${c.free?"FREE":money(c.price)}</div></div>
 <button class="btn ${c.free?"mint":""}" id="casebtn${i}" style="width:100%;margin-top:6px" onclick="openCase(${i})" ${r>0?"disabled":""}>${btn}</button></div>`;}).join("");}
function renderGames(){document.getElementById("gamegrid").innerHTML=games.map((g,i)=>`<div class="gamecard reveal" style="background:linear-gradient(135deg,${g.c1},${g.c2})" onclick="openGame(${i})"><span class="gname">${g.name}</span></div>`).join("");}
function renderCollection(){const box=document.getElementById("collection");document.getElementById("giftcount").textContent=state.collection.length+" шт.";
 if(!state.collection.length){box.innerHTML=`<div class="collectionempty glass">Коллекция пока пустая.<br>Открой свой первый кейс! 🎁</div>`;return;}
