 return `<div class="giftcard glass reveal on ${rarityClass[g.rarity]}"><img src="${g.image}" ${fallFor(g.id)}><h3>${g.name}</h3><div class="rartag">${g.rarity}</div><div class="starbadge">⭐ ${g.stars}</div>
 <div class="giftbtns"><button class="btn secondary" onclick="sellGift(${i})">Продать ${money(g.sell)}</button><button class="btn" onclick="withdrawGift('${g.id}')">📤 Вывести</button></div></div>`;}).join("");}
function render(){document.getElementById("balance").textContent="🔵 "+money(state.balance);updateSoundBtn();renderCases();renderGames();renderCollection();observeReveals();}
let observer;
function observeReveals(){observer?.disconnect();if(!("IntersectionObserver" in window)){document.querySelectorAll(".reveal").forEach(e=>e.classList.add("on"));return;}
 observer=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("on");observer.unobserve(e.target);}});},{threshold:.08});
 document.querySelectorAll(".reveal:not(.on)").forEach(el=>observer.observe(el));
 setTimeout(()=>document.querySelectorAll(".reveal:not(.on)").forEach(el=>{const r=el.getBoundingClientRect();if(r.top<window.innerHeight)el.classList.add("on");}),120);}
function showModal(h){document.getElementById("modalcontent").innerHTML=`<button class="mclose" onclick="closeModal()">×</button>`+h;document.getElementById("modal").classList.add("show");}
let caseTimers=[],gameTimers=[],crashRAF=0,pkRAF=0,crashState=null,minesState=null,pkState=null,minesSel=5,crashHist=[],pkHist=[];
function clearCaseTimers(){caseTimers.forEach(clearTimeout);caseTimers=[];}
function stopGameLoops(){gameTimers.forEach(clearInterval);gameTimers=[];cancelAnimationFrame(crashRAF);cancelAnimationFrame(pkRAF);crashRAF=0;pkRAF=0;crashState=null;minesState=null;pkState=null;}
function closeModal(){clearCaseTimers();stopGameLoops();document.getElementById("modal").classList.remove("show");}
document.getElementById("modal").addEventListener("click",e=>{if(e.target.id==="modal")closeModal();});
function later(fn,ms){const t=setTimeout(fn,ms);gameTimers.push(t);return t;}

/* кейсы */
function openCase(i){const c=cases[i];if(c.free){const r=freeRemain();if(r>0)return toast("Кейс через "+fmtRemain(r));if(!state.subscribed)return subscribeModal();return spinCase(c);}if(!pay(c.price))return;spinCase(c);}
function subscribeModal(){showModal(`<h2>🔔 Бесплатный кейс</h2><div class="tgcard"><span class="tgicon">✈️</span><h3>Подпишись на канал</h3><p class="muted">Подпишись, чтобы открыть бесплатный кейс. Повторно — каждые 24 часа.</p></div>
<div class="grow" style="flex-direction:column"><a class="btn tg" style="width:100%" href="${TG_CHANNEL}" target="_blank" rel="noopener" onclick="tgClicked()">✈️ Подписаться</a><button class="btn mint" id="tgdone" disabled onclick="claimFree()">✅ Я подписался — открыть</button></div>`);}
function tgClicked(){setTimeout(()=>{const b=document.getElementById("tgdone");if(b)b.disabled=false;},1500);}
function claimFree(){state.subscribed=true;save();spinCase(cases[0]);}
function rollEntry(t){const tot=t.reduce((s,x)=>s+x[0],0);let r=Math.random()*tot;for(const[w,e]of t){r-=w;if(r<=0)return e;}return t[t.length-1][1];}
const tileFor=e=>{if(e.nft){const g=giftById(e.nft);return{img:g.image,label:g.name,fb:fallFor(e.nft)};}if(e.cash)return{img:cashIcon,label:"ДЖЕКПОТ",fb:""};return{img:starIcon(e.stars),label:"+"+e.stars+" ⭐",fb:""};};
function spinCase(item){
 const win=rollEntry(item.table),wt=tileFor(win),isNft=!!win.nft,isCash=!!win.cash;
 const winRub=isNft?giftById(win.nft).price:(isCash?win.cash:win.stars*STAR_RATE);
 const jackpot=isNft||isCash||win.stars>=500;
 const reel=[];for(let i=0;i<22;i++){const t=tileFor(rollEntry(item.table));reel.push(`<div class="reelitem"><img src="${t.img}" ${t.fb}><span>${t.label}</span></div>`);}
 reel.push(`<div class="reelitem" id="winTile"><img src="${wt.img}" ${wt.fb}><span>${wt.label}</span></div>`);
 for(let i=0;i<7;i++){const t=tileFor(rollEntry(item.table));reel.push(`<div class="reelitem"><img src="${t.img}" ${t.fb}><span>${t.label}</span></div>`);}
 let res;
 if(isNft){const g=giftById(win.nft);res=`<div class="prizewrap"><div class="rays"></div><img src="${g.image}" ${fallFor(g.id)}></div><h2 style="margin:6px 0 3px">${g.name}</h2><div class="resultx jackpot">🔥 ДЖЕКПОТ КЕЙСА!</div><div class="rartag" style="margin:0 auto 6px">${g.rarity} · ⭐ ${g.stars}</div><p class="muted">Подарок в коллекции! 🎉</p>`;}
 else if(isCash){res=`<div class="prizewrap"><div class="rays"></div><img src="${cashIcon}"></div><h2 style="margin:6px 0 3px">ДЖЕКПОТ</h2><div class="resultx jackpot">💰 +${money(win.cash)}</div><p class="muted">Максимальный приз зачислен на баланс!</p>`;}
 else{res=`<div class="prizewrap"><div class="rays"></div><img src="${starIcon(win.stars)}"></div><h2 style="margin:6px 0 3px">+${win.stars} ⭐</h2><div class="resultx ${jackpot?"jackpot":""}">${jackpot?"🔥 МЕГА-УЛОВ!":"Звёзды твои!"}</div><p class="muted">+${money(winRub)} на баланс</p>`;}
 showModal(`<h2>${item.name}</h2><div class="xinfo"><div><small>Цена</small><b>${item.free?"FREE":money(item.price)}</b></div><div><small>Макс. приз</small><b>${money(caseMax(item))}</b></div></div>
 <div class="reel spin" id="reelBox"><div class="reelmark"></div><div class="reeltrack spinning" id="reeltrack">${reel.join("")}</div></div>
 <div id="caseResult" class="result">${res}<button class="btn" style="width:100%" onclick="closeModal()">Забрать</button></div>`);
 if(item.free)state.lastFree=Date.now();
 if(isNft)state.collection.push(win.nft);else addMoney(winRub);
 save();
 caseTimers.push(setTimeout(()=>{const t=document.getElementById("reeltrack");if(!t)return;const w=t.parentElement.clientWidth;t.style.transform=`translateX(-${8+22*94+42-w/2+(Math.random()*36-18)}px)`;},120));
 caseTimers.push(setTimeout(()=>{document.getElementById("reeltrack")?.classList.remove("spinning");document.getElementById("reelBox")?.classList.remove("spin");document.getElementById("winTile")?.classList.add("win");
  if(jackpot){confetti(isCash?90:56);SFX.win();const mb=document.querySelector(".modalbox");if(mb){mb.classList.add("shake");setTimeout(()=>mb.classList.remove("shake"),600);}}else{confetti(24);SFX.coin();}},3600));
 caseTimers.push(setTimeout(()=>document.getElementById("caseResult")?.classList.add("show"),3900));
}
function sellGift(i){const g=giftById(state.collection[i]);if(!g)return;state.collection.splice(i,1);addMoney(g.sell);SFX.coin();toast(g.name+" продан за "+money(g.sell));}

/* игры */
function openGame(i){SFX.click();stopGameLoops();[gamePlinko,gameMines,gameSlots,gameCrash][i]();}
function betOf(id){const v=Math.round(parseInt(document.getElementById(id).value))||0;if(v<5){toast("Минимальная ставка 5 ₽");return 0;}return pay(v)?v:0;}

/* PLINKO */
const PK_MULTS=[5,2,1.2,0.5,0.2,0,0.2,0.5,1.2,2,5];
function gamePlinko(){pkState=null;let pegs="";for(let r=0;r<10;r++)for(let i=0;i<=r;i++){pegs+=`<span class="ppeg" id="pg-${r}-${i}" style="left:${50+(i-r/2)*(100/12)}%;top:${16+r*19}px"></span>`;}
 let slots="";for(let k=0;k<11;k++){const m=PK_MULTS[k];slots+=`<span class="pslot ${m<1?"mid":""}" id="ps-${k}" style="left:calc(${50+(k-5)*(100/12)}% - 4%);width:8%">${m}x</span>`;}
 showModal(`<h2>PLINKO</h2><p class="muted">Шарик падает сквозь колышки. Куда упадёт — такой множитель.</p>
 <input class="ginput" id="pBet" type="number" min="5" value="15">
 <div class="pboard" id="pBoard">${pegs}${slots}<span class="pball" id="pBall" style="left:50%;top:6px"></span></div>
 <div class="hist" id="pHist"></div><div class="muted" id="pMsg" style="text-align:center;margin:6px 0">Ставка и «Бросить»</div>
 <button class="btn" style="width:100%" id="pDrop" onclick="pkDrop()">Бросить шарик</button>`);pkHistRender();}
function pkHistRender(){const el=document.getElementById("pHist");if(!el)return;el.innerHTML=pkHist.map(v=>`<span style="color:${v<1?"#ff5a6e":v<2?"#ffd45d":"#39dca0"}">×${v}</span>`).join("")||`<span style="color:var(--muted)">История после первого броска</span>`;}
function pkDrop(){if(pkState)return;const v=betOf("pBet");if(!v)return;document.getElementById("pDrop").disabled=true;SFX.click();
 let rights=0;const pts=[{x:50,y:6}],hits=[];
 for(let r=0;r<10;r++){hits.push([r,rights]);if(Math.random()<0.5)rights++;pts.push({x:50+(rights-(r+1)/2)*(100/12),y:16+(r+1)*19});}
 pts.push({x:50+(rights-5)*(100/12),y:226});
 pkState={bet:v,slot:rights,pts,hits,t0:performance.now(),dur:1400};pkRAF=requestAnimationFrame(pkTick);}
function pkTick(){const s=pkState;if(!s)return;const t=Math.min(1,(performance.now()-s.t0)/s.dur);const seg=t*(s.pts.length-1);const i=Math.min(s.pts.length-2,Math.floor(seg));const f=seg-i;const a=s.pts[i],b=s.pts[i+1];const e=f*f*(3-2*f);
 const ball=document.getElementById("pBall");if(ball){ball.style.left=(a.x+(b.x-a.x)*e)+"%";ball.style.top=(a.y+(b.y-a.y)*e)+"px";}
 const hi=Math.floor(seg);if(hi<s.hits.length){const[r,ri]=s.hits[hi];const peg=document.getElementById("pg-"+r+"-"+ri);if(peg&&!peg.classList.contains("hit")){peg.classList.add("hit");SFX.peg();setTimeout(()=>peg.classList.remove("hit"),200);}}
 if(t>=1){pkFinish();return;}pkRAF=requestAnimationFrame(pkTick);}
function pkFinish(){const s=pkState;if(!s)return;const m=PK_MULTS[s.slot],p=Math.floor(s.bet*m);pkHist.unshift(m);pkHist=pkHist.slice(0,8);pkHistRender();
 const slot=document.getElementById("ps-"+s.slot);if(slot){slot.classList.add("hit");setTimeout(()=>slot.classList.remove("hit"),900);}
 const msg=document.getElementById("pMsg");
 if(m>=1){addMoney(p);if(m>=2){confetti(40);SFX.win();}else SFX.coin();msg.innerHTML=`<b style="color:var(--mint)">×${m} → +${money(p)} 🎉</b>`;}
 else{SFX.lose();msg.innerHTML=`<b style="color:var(--red)">×${m} — мимо</b>`;}
 document.getElementById("pDrop").disabled=false;pkState=null;}

/* MINES */
function minesMult(k,m){let f=1;for(let i=0;i<k;i++)f*=(25-i)/(25-m-i);return Math.max(1,Math.floor(f*.9*100)/100);}
function gameMines(){minesState={active:false,bet:0,mines:minesSel,mineSet:new Set(),safe:0,mult:1};
 showModal(`<h2>MINES</h2><p class="muted">Открывай кристаллы, не попади на мину. Забирай вовремя.</p>
 <input class="ginput" id="mBet" type="number" min="5" value="20">
 <div class="seg" id="mSeg">${[3,5,7].map(n=>`<button class="${n===minesSel?"on":""}" onclick="setMines(${n})">${n} мин</button>`).join("")}</div>
 <div class="xinfo"><div><small>Множитель</small><b id="mMult">×1.00</b></div><div><small>Выигрыш</small><b id="mWin">0 ₽</b></div><div><small>След.</small><b id="mNext">×${minesMult(1,minesSel).toFixed(2)}</b></div></div>
 <div class="mgrid">${Array.from({length:25},(_,i)=>`<button class="mtile" id="mt${i}" onclick="minesPick(${i})" disabled></button>`).join("")}</div>
 <div class="muted" id="mMsg" style="text-align:center;margin:6px 0">Ставка и «Играть»</div>
 <div class="grow"><button class="btn" id="mStart" onclick="minesStart()">Играть</button><button class="btn mint" id="mCash" onclick="minesCash()" disabled>Забрать</button></div>`);refreshMines();}
function setMines(n){if(minesState&&minesState.active)return;minesSel=n;document.querySelectorAll("#mSeg button").forEach((b,i)=>b.classList.toggle("on",[3,5,7][i]===n));document.getElementById("mNext").textContent="×"+minesMult(1,n).toFixed(2);SFX.click();}
function refreshMines(){const s=minesState;if(!s)return;const bet=s.active?s.bet:(Math.round(parseInt(document.getElementById("mBet")?.value))||0);
 document.getElementById("mMult").textContent="×"+s.mult.toFixed(2);document.getElementById("mWin").textContent=money(Math.floor(bet*s.mult));
 document.getElementById("mNext").textContent="×"+minesMult(s.safe+1,s.mines).toFixed(2);
 document.getElementById("mCash").disabled=!(s.active&&s.safe>0);document.getElementById("mStart").disabled=s.active;document.getElementById("mStart").textContent=s.active?"Раунд…":"Играть";}
function minesStart(){const v=betOf("mBet");if(!v)return;const set=new Set();while(set.size<minesSel)set.add(Math.floor(Math.random()*25));
 minesState={active:true,bet:v,mines:minesSel,mineSet:set,safe:0,mult:1};
 for(let i=0;i<25;i++){const t=document.getElementById("mt"+i);t.className="mtile";t.textContent="";t.disabled=false;}
 document.getElementById("mMsg").textContent="Открывай клетки 💎";SFX.click();refreshMines();}
function minesPick(i){const s=minesState;if(!s||!s.active)return;const t=document.getElementById("mt"+i);if(t.disabled)return;t.disabled=true;
 if(s.mineSet.has(i)){t.classList.add("bomb");t.textContent="💣";s.active=false;SFX.boom();
  s.mineSet.forEach(m=>{const e=document.getElementById("mt"+m);if(!e.classList.contains("bomb")){e.classList.add("bomb");e.textContent="💣";}});
  for(let k=0;k<25;k++){const e=document.getElementById("mt"+k);e.disabled=true;if(!e.classList.contains("bomb")&&!e.classList.contains("gem"))e.classList.add("dim");}
  document.getElementById("mMsg").innerHTML=`<b style="color:var(--red)">💥 Мина! Ставка сгорела</b>`;refreshMines();return;}
 t.classList.add("gem");t.textContent="💎";s.safe++;s.mult=minesMult(s.safe,s.mines);SFX.gem();refreshMines();if(s.safe===25-s.mines)minesCash();}
function minesCash(){const s=minesState;if(!s||!s.active||s.safe<1)return;const p=Math.floor(s.bet*s.mult);s.active=false;addMoney(p);
 s.mineSet.forEach(m=>{const e=document.getElementById("mt"+m);e.classList.add("dim");e.textContent="💣";});
 for(let k=0;k<25;k++)document.getElementById("mt"+k).disabled=true;
 confetti(40);SFX.win();document.getElementById("mMsg").innerHTML=`<b style="color:var(--mint)">Забрал ×${s.mult.toFixed(2)} = ${money(p)} 🎉</b>`;refreshMines();}

/* SLOTS */
const SLOT_SYM=[{s:"🍒",w:30,m:3},{s:"🍋",w:26,m:4},{s:"🔔",w:18,m:6},{s:"💎",w:12,m:12},{s:"7️⃣",w:8,m:25},{s:"⭐",w:6,m:50}];
function slotPick(){const tot=SLOT_SYM.reduce((a,b)=>a+b.w,0);let r=Math.random()*tot;for(const x of SLOT_SYM){r-=x.w;if(r<=0)return x;}return SLOT_SYM[0];}
function gameSlots(){showModal(`<h2>SLOTS</h2><p class="muted">Три одинаковых символа — большой выигрыш. Два — возврат ×1.2.</p>
 <input class="ginput" id="sBet" type="number" min="5" value="15">
 <div class="slotwrap" style="position:relative"><div class="slotreel" id="sr0">🍒</div><div class="slotreel" id="sr1">💎</div><div class="slotreel" id="sr2">⭐</div><div class="slotline"></div></div>
 <div class="muted" id="sMsg" style="text-align:center;margin:6px 0">Ставка и «Крутить»</div>
 <button class="btn gold" style="width:100%" id="sSpin" onclick="slotsSpin()">Крутить</button>`);}
function slotsSpin(){const v=betOf("sBet");if(!v)return;document.getElementById("sSpin").disabled=true;SFX.click();
 const finals=[slotPick(),slotPick(),slotPick()];
 const reels=[0,1,2].map(i=>document.getElementById("sr"+i));
 reels.forEach(r=>{r.classList.add("spin");r.classList.remove("stop");});
 const iv=setInterval(()=>{reels.forEach((r,i)=>{if(!r.dataset.done)r.textContent=SLOT_SYM[Math.floor(Math.random()*SLOT_SYM.length)].s;});},70);gameTimers.push(iv);
 reels.forEach((r,i)=>{later(()=>{r.dataset.done="1";r.textContent=finals[i].s;r.classList.remove("spin");r.classList.add("stop");SFX.peg();
  if(i===2){clearInterval(iv);reels.forEach(x=>delete x.dataset.done);slotsResult(v,finals);}},700+i*450);});}
function slotsResult(bet,f){const msg=document.getElementById("sMsg");let mult=0;
 if(f[0].s===f[1].s&&f[1].s===f[2].s)mult=f[0].m;
 else if(f[0].s===f[1].s||f[1].s===f[2].s||f[0].s===f[2].s)mult=1.2;
 const p=Math.floor(bet*mult);
 if(mult>=3){addMoney(p);confetti(50);SFX.win();msg.innerHTML=`<b style="color:var(--mint)">×${mult} → +${money(p)} 🎰</b>`;}
 else if(mult>0){addMoney(p);SFX.coin();msg.innerHTML=`<b style="color:var(--gold)">×${mult} → +${money(p)}</b>`;}
 else{SFX.lose();msg.innerHTML=`<b style="color:var(--red)">Мимо — ставка сгорела</b>`;}
 document.getElementById("sSpin").disabled=false;}

/* CRASH */
function gameCrash(){crashState=null;const stars=Array.from({length:20},()=>`<span class="st" style="left:${Math.random()*100}%;top:${Math.random()*100}%;animation-delay:${Math.random()*2}s"></span>`).join("");
 showModal(`<h2>CRASH</h2><p class="muted">Множитель растёт — забери до взрыва ракеты!</p>
 <input class="ginput" id="cBet" type="number" min="5" value="15">
 <div class="sky" id="cSky">${stars}<div class="trail" id="cTrail" style="height:0"></div><div class="rocket" id="cRocket">🚀</div><div class="crashmult" id="cMult">×1.00</div></div>
 <div class="hist" id="cHist"></div><div class="muted" id="cMsg" style="text-align:center;margin:6px 0">Ставка и «Старт»</div>
 <div class="grow"><button class="btn" id="cStart" onclick="crashStart()">Старт</button><button class="btn mint" id="cCash" onclick="crashCash()" disabled>Забрать</button></div>`);crashHistRender();}
function crashHistRender(){const el=document.getElementById("cHist");if(!el)return;el.innerHTML=crashHist.map(v=>`<span style="color:${v<1.5?"#ff5a6e":v<3?"#ffd45d":"#39dca0"}">×${v.toFixed(2)}</span>`).join("")||`<span style="color:var(--muted)">История после первого раунда</span>`;}
function crashStart(){const v=betOf("cBet");if(!v)return;const crash=Math.random()<0.1?1:Math.min(500,Math.max(1.01,.9/(1-Math.random())));
 crashState={bet:v,crash,active:true,t0:performance.now(),mult:1};
 document.getElementById("cStart").disabled=true;document.getElementById("cCash").disabled=false;
 document.getElementById("cSky").classList.remove("crashed");document.getElementById("cRocket").textContent="🚀";
 document.getElementById("cMsg").textContent="Ракета летит…";SFX.click();crashRAF=requestAnimationFrame(crashTick);}
function crashTick(){const s=crashState;if(!s||!s.active)return;const t=(performance.now()-s.t0)/1000;const m=Math.pow(1.07,t);
 if(m>=s.crash){crashEnd(false);return;}s.mult=m;
 const el=document.getElementById("cMult");el.textContent="×"+m.toFixed(2);el.style.color=m<2?"#c4b5fd":m<5?"#39dca0":"#ffd45d";
 const up=Math.min(110,(m-1)*14);document.getElementById("cRocket").style.transform=`translateX(calc(-50% + ${Math.sin(t*3)*8}px)) translateY(-${up}px) rotate(-45deg)`;
 document.getElementById("cTrail").style.height=Math.min(140,up+20)+"px";crashRAF=requestAnimationFrame(crashTick);}
function crashCash(){const s=crashState;if(!s||!s.active)return;const p=Math.floor(s.bet*s.mult);addMoney(p);confetti(40);SFX.win();
 document.getElementById("cMsg").innerHTML=`<b style="color:var(--mint)">Забрал ×${s.mult.toFixed(2)} = ${money(p)} 🚀</b>`;crashEnd(true);}
function crashEnd(cashed){const s=crashState;if(!s)return;s.active=false;cancelAnimationFrame(crashRAF);
 crashHist.unshift(s.crash);crashHist=crashHist.slice(0,8);crashHistRender();
 document.getElementById("cStart").disabled=false;document.getElementById("cCash").disabled=true;
 const el=document.getElementById("cMult");el.textContent="×"+s.crash.toFixed(2);
 if(!cashed){el.style.color="#ff5a6e";document.getElementById("cSky").classList.add("crashed");document.getElementById("cRocket").textContent="💥";document.getElementById("cTrail").style.height="0";SFX.boom();document.getElementById("cMsg").innerHTML=`<b style="color:var(--red)">💥 Взрыв на ×${s.crash.toFixed(2)}</b>`;}
 crashState=null;}

